<Window x:Class="Laundry.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LaundryAPP" Height="540" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="LaundryAPP" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Mode terang/gelap" Command="{Binding ToggleThemeCommand}"/><Button Content="Kunci Aplikasi" Command="{Binding LockCommand}"/></StackPanel></DockPanel>
        <Grid Grid.Row="1" VerticalAlignment="Center" Width="440">
            <StackPanel Visibility="{Binding LoginVisibility}">
                <TextBlock Text="Masuk" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Nomor WhatsApp" Margin="0,12,0,4"/><TextBox Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Password" Margin="0,12,0,4"/><PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged"/>
                <Button Content="Masuk" Command="{Binding LoginCustomerCommand}" IsEnabled="{Binding CanSubmit}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Visibility="{Binding DashboardVisibility}">
                <TextBlock Text="{Binding DashboardTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DashboardSummary}" Margin="0,12,0,4" TextWrapping="Wrap"/>
                <Border Background="#EFF6FF" Padding="16" Margin="0,12,0,0"><TextBlock Text="{Binding SyncStatus}"/></Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
